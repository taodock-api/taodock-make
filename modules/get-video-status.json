{
  "name": "getVideoStatus",
  "label": "Get Video Status",
  "description": "Check the status and progress of a Taodock video generation task.",
  "type": "action",
  "connection": "apiKey",
  "communication": {
    "url": "/videos/{{parameters.taskId}}",
    "method": "GET",
    "response": {
      "output": {
        "task_id": "{{body.id || body.task_id || parameters.taskId}}",
        "status": "{{body.status}}",
        "progress": "{{if(body.progress >= 0; body.progress; ignore)}}",
        "model": "{{ifempty(body.model; ignore; body.model)}}"
      }
    }
  },
  "parameters": [
    {
      "name": "taskId",
      "type": "text",
      "label": "Task ID",
      "help": "The task ID returned by Create Video.",
      "required": true
    }
  ],
  "interface": [
    {
      "name": "task_id",
      "type": "text",
      "label": "Task ID"
    },
    {
      "name": "status",
      "type": "text",
      "label": "Status"
    },
    {
      "name": "progress",
      "type": "uinteger",
      "label": "Progress (%)"
    },
    {
      "name": "model",
      "type": "text",
      "label": "Model"
    }
  ]
}
